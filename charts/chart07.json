{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Census online participation rose in every state",
    "subtitle": "2011, 2016 and 2021 · use the selector; the interactive summary below updates with exact values",
    "anchor": "start",
    "fontSize": 17,
    "fontWeight": "normal",
    "color": "#263940",
    "subtitleColor": "#59696d",
    "subtitleFontSize": 12
  },
  "width": "container",
  "height": 285,
  "data": {
    "url": "data/census_online.csv"
  },
  "params": [
    {
      "name": "focus",
      "value": "Australia",
      "bind": {
        "input": "select",
        "name": "Highlight: ",
        "options": [
          "Australia",
          "New South Wales",
          "Victoria",
          "Queensland",
          "South Australia",
          "Western Australia",
          "Tasmania",
          "Northern Territory",
          "Australian Capital Territory"
        ]
      }
    }
  ],
  "transform": [
    {
      "calculate": "datum.state === focus",
      "as": "selected"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2.5,
        "point": {
          "filled": true,
          "size": 90
        }
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "sort": [
            2011,
            2016,
            2021
          ],
          "axis": {
            "labelAngle": 0
          },
          "title": null
        },
        "y": {
          "field": "percent",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ]
          },
          "title": "Online Census response (%)"
        },
        "detail": {
          "field": "state",
          "type": "nominal"
        },
        "color": {
          "condition": {
            "test": "datum.state === focus",
            "value": "#CC693B"
          },
          "value": "#B8C9D1"
        },
        "opacity": {
          "condition": {
            "test": "datum.state === focus",
            "value": 1
          },
          "value": 0.5
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal"
          },
          {
            "field": "year",
            "type": "ordinal"
          },
          {
            "field": "percent",
            "type": "quantitative",
            "format": ".1f",
            "title": "Responded online (%)"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.state === focus && datum.year === 2021"
        }
      ],
      "mark": {
        "type": "text",
        "dx": 8,
        "align": "left",
        "fontSize": 13,
        "fontWeight": "bold",
        "color": "#CC693B"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal"
        },
        "y": {
          "field": "percent",
          "type": "quantitative"
        },
        "text": {
          "field": "percent",
          "type": "quantitative",
          "format": ".1f"
        }
      }
    }
  ],
  "config": {
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "axis": {
      "gridColor": "#E7EDF0",
      "labelColor": "#263940"
    }
  }
}
