{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "State scores vary less than demographic ability",
    "subtitle": "2025 \u00b7 ACT 79.6, Tasmania 69.7 \u00b7 9.9-point spread across states",
    "anchor": "start",
    "fontSize": 18,
    "subtitleFontSize": 12,
    "color": "#243847"
  },
  "width": 760,
  "height": 430,
  "projection": {
    "type": "mercator",
    "center": [
      134,
      -27
    ],
    "scale": 530,
    "translate": [
      380,
      200
    ]
  },
  "data": {
    "url": "data/australia_states_simplified.geojson",
    "format": {
      "type": "json",
      "property": "features"
    }
  },
  "mark": {
    "type": "geoshape",
    "stroke": "#FFFFFF",
    "strokeWidth": 1.4
  },
  "encoding": {
    "color": {
      "field": "properties.ability",
      "type": "quantitative",
      "scale": {
        "domain": [
          69,
          80
        ],
        "range": [
          "#E7F3F3",
          "#B9D7DB",
          "#6EACB7",
          "#2E789E",
          "#234C75"
        ]
      },
      "legend": {
        "title": "Digital ability index \u00b7 zoomed 69\u201380",
        "orient": "bottom",
        "values": [
          69,
          71,
          73,
          75,
          77,
          79,
          80
        ],
        "gradientLength": 330
      }
    },
    "tooltip": [
      {
        "field": "properties.STATE_NAME",
        "title": "State / territory"
      },
      {
        "field": "properties.ability",
        "type": "quantitative",
        "title": "Ability (0\u2013100)",
        "format": ".1f"
      }
    ]
  },
  "config": {
    "background": "transparent",
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "legend": {
      "labelColor": "#263940",
      "titleColor": "#263940"
    }
  }
}