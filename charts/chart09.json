{
  "title": {
    "text": "Online Census: participation and growth differ by state",
    "subtitle": "Circle AREA = 2021 online response; COLOUR = gain since 2011 (percentage points)",
    "anchor": "start",
    "fontSize": 17,
    "fontWeight": "normal",
    "color": "#263940",
    "subtitleColor": "#59696d",
    "subtitleFontSize": 12
  },
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "config": {
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "font": "Arial",
    "axis": {
      "labelColor": "#263940",
      "titleColor": "#263940",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "gridColor": "#e1e8e8"
    },
    "legend": {
      "titleColor": "#263940",
      "labelColor": "#263940",
      "labelFontSize": 12
    }
  },
  "width": 680,
  "height": 390,
  "projection": {
    "type": "mercator",
    "center": [
      134,
      -27
    ],
    "scale": 545,
    "translate": [
      340,
      195
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/australia_outline.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e6eae7",
        "stroke": "#849795",
        "strokeWidth": 1.1
      }
    },
    {
      "data": {
        "url": "data/states_census_change_map.csv"
      },
      "mark": {
        "type": "circle",
        "stroke": "#ffffff",
        "strokeWidth": 1.5,
        "opacity": 0.86
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "size": {
          "field": "online2021",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ],
            "range": [
              100,
              1900
            ]
          },
          "legend": {
            "title": "Share of forms online (%)",
            "values": [
              60,
              75,
              90
            ],
            "orient": "bottom"
          }
        },
        "tooltip": [
          {
            "field": "state",
            "title": "State / territory"
          },
          {
            "field": "online2021",
            "type": "quantitative",
            "title": "Response (%)",
            "format": ".1f"
          },
          {
            "field": "increase_11_21",
            "type": "quantitative",
            "title": "2011–21 increase (pp)",
            "format": "+.1f"
          }
        ],
        "color": {
          "field": "increase_11_21",
          "type": "quantitative",
          "scale": {
            "domain": [
              30,
              50
            ],
            "range": [
              "#F0C7A7",
              "#CB7047",
              "#315B95"
            ]
          },
          "legend": {
            "title": "2011–21 gain (pp)",
            "orient": "bottom",
            "gradientLength": 230
          }
        }
      }
    },
    {
      "data": {
        "url": "data/states_census_map.csv"
      },
      "mark": {
        "type": "text",
        "dy": -20,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#263940"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "code",
          "type": "nominal"
        }
      }
    }
  ]
}
